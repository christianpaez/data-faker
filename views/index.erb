

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <% @constants.each do |constant| %>
      <a class="border-2 border-black bg-white px-5 py-3 mb-3 font-semibold text-black shadow-[4px_4px_0_0] shadow-black hover:bg-yellow-200 focus:ring-2 focus:ring-yellow-300 focus:outline-0" href="/?resource=<%= constant %>">  
      <%= constant %>
    </a>

  <% end %>


  METHODS


<% @methods&.each do |method| %>
  <% 
    current_resource = params[:resource]
    href = current_resource ? "/?resource=#{current_resource}&field=#{method}" : "/?field=#{method}"
  %>
  <a class="border-2 border-black bg-white px-5 py-3 mb-3 font-semibold text-black shadow-[4px_4px_0_0] shadow-black hover:bg-yellow-200 focus:ring-2 focus:ring-yellow-300 focus:outline-0" 
     href="<%= href %>">  
    <%= method %>
  </a>
<% end %>


result

